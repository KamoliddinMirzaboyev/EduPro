{
  "name": "edupro-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EDUPRO — Next-Generation Creator-First LMS & EdTech Marketplace",
  "scripts": {
    "dev:backend": "cd backend && ./venv/bin/python manage.py runserver 0.0.0.0:8000",
    "dev:admin": "cd superadmin && npm run dev",
    "dev:teacher": "cd teacher && npm run dev",
    "dev:student": "cd student && npm run dev",
    "seed": "cd backend && ./venv/bin/python manage.py seed_edupro",
    "migrate": "cd backend && ./venv/bin/python manage.py migrate",
    "start": "./start_all.sh"
  }
}
